@echo off
setlocal
title Nightzim BoomMod v3.3 beta
set "NZ_SELF=%~f0"
set "NZ_SHA=4E38A7113054AAD7ACA99B83CE862EDDE48AD32F3CCF25E1DE4B49EFF37BAEC1"
if not defined NZ_DEST set "NZ_DEST=%USERPROFILE%\Saved Games\DCS\Nightzim_BoomMod_v3_3beta"
set "NZ_ACAO=%~1"
if defined NZ_ACAO shift
if not defined NZ_ACAO (
  echo.
  echo   Nightzim BoomMod v3.3 beta
  echo   Feche o DCS antes de continuar.
  echo.
  echo   1 - Instalar / atualizar
  echo   2 - Restaurar os efeitos originais do DCS
  echo   3 - Sair
  echo.
  choice /c 123 /n /m "Escolha [1,2,3]: "
  if errorlevel 3 exit /b 0
  if errorlevel 2 (set "NZ_ACAO=restaurar") else (set "NZ_ACAO=instalar")
  set "NZ_PAUSA=1"
)
if /i not "%NZ_ACAO%"=="instalar" if /i not "%NZ_ACAO%"=="restaurar" (echo Uso: %~nx0 [instalar^|restaurar] [-DCS "pasta"] & exit /b 2)
echo Extraindo arquivos para "%NZ_DEST%" ...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop';$l=[IO.File]::ReadAllLines($env:NZ_SELF);$i=[Array]::IndexOf($l,'::NZPAYLOAD::');if($i -lt 0){throw 'pacote nao encontrado dentro do .bat'};$b=[Convert]::FromBase64String([string]::Join('',$l,$i+1,$l.Length-$i-1));$h=[BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash($b)).Replace('-','');if($h -ne $env:NZ_SHA){throw 'arquivo .bat corrompido (hash nao confere) - baixe de novo'};New-Item -ItemType Directory -Force $env:NZ_DEST|Out-Null;$z=Join-Path $env:TEMP 'nz_boommod.zip';[IO.File]::WriteAllBytes($z,$b);Expand-Archive -LiteralPath $z -DestinationPath $env:NZ_DEST -Force;Remove-Item $z"
if errorlevel 1 (echo. & echo FALHOU ao extrair. Nada foi alterado no DCS. & if defined NZ_PAUSA pause
exit /b 1)
powershell -NoProfile -ExecutionPolicy Bypass -File "%NZ_DEST%\%NZ_ACAO%.ps1" %1 %2 %3 %4
set "NZ_RC=%errorlevel%"
echo.
if not "%NZ_RC%"=="0" echo Nao concluiu - leia a mensagem acima.
if defined NZ_PAUSA pause
exit /b %NZ_RC%
